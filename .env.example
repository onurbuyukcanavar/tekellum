# Uygulamanın çalışırken kullandığı bağlantı.
# Supabase kullanıyorsanız: Project Settings → Database → Connection string → "Transaction pooler" (6543 portu).
DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:6543/postgres?sslmode=require"

# Migration'ların kullandığı doğrudan bağlantı (havuzsuz).
# Supabase: "Session pooler" (5432 portu) ya da "Direct connection". Boş bırakılırsa DATABASE_URL kullanılır.
DIRECT_URL="postgresql://KULLANICI:PAROLA@HOST:5432/postgres?sslmode=require"

# Sitenin son HTTPS adresi (sitemap, kanonik bağlantılar). Yerelde http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
