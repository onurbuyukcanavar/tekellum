# Uygulamanın çalışırken kullandığı bağlantı.
# Supabase: üst menüdeki "Connect" → "Transaction pooler" (6543 portu). [YOUR-PASSWORD] yerine veritabanı parolanızı yazın.
DATABASE_URL="postgresql://postgres.PROJE_KODU:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Migration'ların kullandığı havuzsuz bağlantı.
# Supabase: "Connect" → "Session pooler" (5432 portu). Boş bırakılırsa DATABASE_URL kullanılır.
DIRECT_URL="postgresql://postgres.PROJE_KODU:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase kök sertifikası: Project Settings → Database → SSL Configuration → "Download certificate"
# (prod-ca-2021.crt). Dosyanın içeriğini olduğu gibi yapıştırın. Tanımlıysa bağlantı tam doğrulamayla şifrelenir.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Sitenin son HTTPS adresi (sitemap, kanonik bağlantılar). Yerelde http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
