// Müessir veri modeli.
// Tablo adları, eski Supabase tablolarıyla (articles, laws, admin_users) çakışmayacak şekilde seçildi;
// aynı veritabanına kurulsa bile eski veriye dokunulmaz ve `npm run veri:aktar` ile taşınabilir.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  TASLAK
  YAYINDA
}

enum VerificationStatus {
  DOGRULANMAYI_BEKLIYOR
  DOGRULANDI
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("user_account")
}

/// Oturum belirteci veritabanında yalnızca SHA-256 özeti olarak saklanır.
model Session {
  id        String   @id // belirtecin SHA-256 özeti
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String   @default("") @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Kaba kuvvet girişimlerine karşı başarısız giriş kayıtları.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "ip:<adres>" veya "email:<adres>"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_attempt")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  /// Sunucuda temizlenmiş HTML (Tiptap çıktısı)
  content     String        @default("")
  category    String        @default("Hukuk")
  author      String        @default("Müessir")
  status      ArticleStatus @default(TASLAK)
  featured    Boolean       @default(false)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lawRefs     ArticleLaw[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("article")
}

model Law {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  lawNumber          String             @default("") @map("law_number")
  shortName          String             @default("") @map("short_name")
  officialUrl        String             @default("") @map("official_url")
  /// Yönetici tarafından girilen düz metin. Doğrulanana kadar resmî metin gibi sunulmaz.
  content            String             @default("")
  verificationStatus VerificationStatus @default(DOGRULANMAYI_BEKLIYOR) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  articleRefs        ArticleLaw[]

  @@map("law")
}

/// Makale ↔ kanun maddesi ilişkisi (ör. TBK m. 49).
model ArticleLaw {
  id        String  @id @default(cuid())
  articleId String  @map("article_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lawId     String  @map("law_id")
  law       Law     @relation(fields: [lawId], references: [id], onDelete: Cascade)
  /// Madde numarası/aralığı, ör. "49" veya "49-52". Boşsa kanunun bütününe atıf.
  provision String  @default("")

  @@unique([articleId, lawId, provision])
  @@index([lawId])
  @@map("article_law")
}
