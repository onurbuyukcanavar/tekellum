// Müessir veri modeli.
// Tablo adları, eski Supabase tablolarıyla (articles, laws, admin_users) çakışmayacak şekilde seçildi;
// aynı veritabanına kurulsa bile eski veriye dokunulmaz ve `npm run veri:aktar` ile taşınabilir.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  TASLAK
  YAYINDA
}

enum VerificationStatus {
  DOGRULANMAYI_BEKLIYOR
  DOGRULANDI
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("user_account")
}

/// Oturum belirteci veritabanında yalnızca SHA-256 özeti olarak saklanır.
model Session {
  id        String   @id // belirtecin SHA-256 özeti
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String   @default("") @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Kaba kuvvet girişimlerine karşı başarısız giriş kayıtları.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "ip:<adres>" veya "email:<adres>"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_attempt")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  /// Sunucuda temizlenmiş HTML (Tiptap çıktısı)
  content     String        @default("")
  category    String        @default("Hukuk")
  author      String        @default("Müessir")
  status      ArticleStatus @default(TASLAK)
  featured    Boolean       @default(false)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lawRefs     ArticleLaw[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("article")
}

model Law {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  lawNumber          String             @default("") @map("law_number")
  shortName          String             @default("") @map("short_name")
  officialUrl        String             @default("") @map("official_url")
  /// Yönetici tarafından girilen düz metin. Doğrulanana kadar resmî metin gibi sunulmaz.
  content            String             @default("")
  verificationStatus VerificationStatus @default(DOGRULANMAYI_BEKLIYOR) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  articleRefs        ArticleLaw[]

  @@map("law")
}

/// Makale ↔ kanun maddesi ilişkisi (ör. TBK m. 49).
model ArticleLaw {
  id        String  @id @default(cuid())
  articleId String  @map("article_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lawId     String  @map("law_id")
  law       Law     @relation(fields: [lawId], references: [id], onDelete: Cascade)
  /// Madde numarası/aralığı, ör. "49" veya "49-52". Boşsa kanunun bütününe atıf.
  provision String  @default("")

  @@unique([articleId, lawId, provision])
  @@index([lawId])
  @@map("article_law")
}

enum GazetteItemKind {
  /// Metni sitede okunabilen HTML içerik
  METIN
  /// Resmî Gazete'de yalnızca PDF olarak yayımlanan içerik
  PDF
  /// İlân bölümü bağlantıları (yalnızca resmî kaynağa yönlendirilir)
  ILAN
}

/// Resmî Gazete sayısı. Aynı güne ait mükerrer sayılar `supplement` (1, 2, …) ile ayrılır.
model GazetteIssue {
  id         String        @id @default(cuid())
  /// Yayım günü (Türkiye saatiyle), UTC gece yarısı olarak saklanır
  date       DateTime      @db.Date
  supplement Int           @default(0)
  number     Int
  sourceUrl  String        @map("source_url")
  pdfUrl     String        @default("") @map("pdf_url")
  fetchedAt  DateTime      @default(now()) @map("fetched_at")
  items      GazetteItem[]

  @@unique([date, supplement])
  @@index([date(sort: Desc)])
  @@map("gazette_issue")
}

model GazetteItem {
  id        String          @id @default(cuid())
  issueId   String          @map("issue_id")
  issue     GazetteIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  /// Fihristteki sıra (0'dan başlar)
  position  Int
  /// Resmî dosya adındaki sıra numarası, ör. "20261111-3.htm" için "3"; adres bu değerle kurulur
  code      String
  section   String
  category  String          @default("")
  title     String
  kind      GazetteItemKind
  sourceUrl String          @map("source_url")
  /// Temizlenmiş HTML (yalnızca METIN türü için, çekildikten sonra dolar)
  content   String          @default("")
  /// Metin çekilemediyse son hata (ör. "HTTP 404")
  error     String          @default("")
  contentFetchedAt DateTime? @map("content_fetched_at")

  @@unique([issueId, code])
  @@index([issueId, position])
  @@map("gazette_item")
}
